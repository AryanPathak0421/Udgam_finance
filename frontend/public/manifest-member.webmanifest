{
  "id": "/member/",
  "name": "Udgam Microfinance - Member App",
  "short_name": "Udgam Member",
  "description": "Udgam Microfinance Customer Portal for Loan Schedule, EMI Details, Passbook & Requests",
  "start_url": "/member/login",
  "scope": "/member/",
  "display": "standalone",
  "background_color": "#064e3b",
  "theme_color": "#059669",
  "orientation": "portrait",
  "lang": "en-IN",
  "categories": ["finance", "business"],
  "icons": [
    {
      "src": "/icon-member-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-member-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-member-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "My Loans",
      "short_name": "Loans",
      "description": "View active loans and EMI repayment schedule",
      "url": "/member/loans",
      "icons": [{ "src": "/icon-member-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Pay EMI",
      "short_name": "Pay EMI",
      "description": "UPI & QR online payment details",
      "url": "/member/emi-pay",
      "icons": [{ "src": "/icon-member-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Member Passbook",
      "short_name": "Passbook",
      "description": "View payments history & receipts",
      "url": "/member/passbook",
      "icons": [{ "src": "/icon-member-192.png", "sizes": "192x192" }]
    }
  ]
}
