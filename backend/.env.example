PORT=5001
MONGODB_URI=mongodb://127.0.0.1:27017/udgam_finance
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# Allowed frontend origin(s), comma-separated, no trailing slash.
# Dev:        http://localhost:5173
# Production: https://your-frontend-domain.com
CLIENT_ORIGIN=http://localhost:5173

NODE_ENV=development

# Production only:
# TRUST_PROXY=1            # when behind a reverse proxy / PaaS
# COOKIE_SAMESITE=none     # only if frontend and API are on different sites (needs HTTPS)

# --- Forgot password email (SMTP) ---
# Gmail: enable 2-Step Verification, create an App Password, then use it as SMTP_PASS.
# Without these, reset emails are NOT sent (in development the link is printed to the console).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=youraddress@gmail.com
# SMTP_PASS=your-16-char-app-password
# MAIL_FROM=Udgam Microfinance <youraddress@gmail.com>
# Public frontend URL used in the reset link (defaults to the first CLIENT_ORIGIN).
# APP_URL=https://udgam-finance.vercel.app
